# Local reports; keep the printable calibration target only.
/output/*
!/output/pdf/
!/output/pdf/A4_charuco_22x15_12mm_DICT_5X5_250.pdf

# Optional simulator environments and generated datasets stay local.
synthetic_pcb_structured_light/.venv/
synthetic_pcb_structured_light/.pytest_cache/
synthetic_pcb_structured_light/output/*
!synthetic_pcb_structured_light/output/.gitkeep

